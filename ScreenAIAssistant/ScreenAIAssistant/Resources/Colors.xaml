<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ☀️ BẢNG MÀU CHẾ ĐỘ SÁNG (LIGHT THEME) — TỐI ƯU CHO HỌC TẬP
        • Nền trắng ngà dịu (#F6F8FB) thay vì trắng tinh để giảm chói mắt khi học lâu.
        • Màu chủ đạo Xanh dương trầm (#2F6FEB): tạo cảm giác tập trung, bình tĩnh.
        • Xanh ngọc (Teal) cho Giờ học, Hổ phách (Amber) cho Deadline, Xanh lá cho Hoàn thành.
        • Chữ xám than (#1F2937) thay vì đen tuyền để giảm độ tương phản gắt.
        Mọi khóa (x:Key) phải trùng khớp với ColorsDark.xaml để chuyển theme bằng DynamicResource.
    -->

    <!-- Nền ứng dụng & Bề mặt thẻ -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#F6F8FB" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F8FB" />
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F1F4F9" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EAF1FE" />
    <SolidColorBrush x:Key="CanvasAreaBrush" Color="#E4E9F0" />

    <!-- Viền -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#2F6FEB" />
    <SolidColorBrush x:Key="PlaceholderBorderBrush" Color="#CBD5E1" />

    <!-- Thanh điều hướng (Sidebar) -->
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#334155" />
    <SolidColorBrush x:Key="SidebarTextMutedBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="SidebarItemActiveBrush" Color="#E8F0FE" />
    <SolidColorBrush x:Key="SidebarItemActiveTextBrush" Color="#1D4ED8" />

    <!-- Chữ -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4B5563" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8A94A6" />
    <SolidColorBrush x:Key="TextInverseBrush" Color="#FFFFFF" />

    <!-- Màu chủ đạo (Tập trung) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2F6FEB" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1E4FC2" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#E8F0FE" />

    <!-- Màu nhấn theo ngữ nghĩa học tập -->
    <SolidColorBrush x:Key="AccentTealBrush" Color="#0F9D8F" />
    <SolidColorBrush x:Key="AccentTealLightBrush" Color="#E0F5F2" />
    <SolidColorBrush x:Key="AccentVioletBrush" Color="#7C5CDB" />
    <SolidColorBrush x:Key="AccentVioletLightBrush" Color="#EFEAFD" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="WarningLightBrush" Color="#FEF3E2" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#E7F6EC" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FDECEC" />

    <!-- Ô nhập liệu & Nút phụ -->
    <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="SecondaryButtonBgBrush" Color="#F1F4F9" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#E2E8F0" />

    <!-- Huy hiệu thông báo (tương thích ngược) -->
    <SolidColorBrush x:Key="BadgeNewBgBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="BadgeNewTextBrush" Color="#991B1B" />
    <SolidColorBrush x:Key="BadgeMasteredBgBrush" Color="#E7F6EC" />
    <SolidColorBrush x:Key="BadgeMasteredTextBrush" Color="#166534" />

</ResourceDictionary>
