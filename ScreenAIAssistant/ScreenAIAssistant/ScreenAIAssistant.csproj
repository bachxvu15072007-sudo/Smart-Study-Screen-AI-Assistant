<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.2" />
  </ItemGroup>

  <!--
    Giải pháp chống khóa file ScreenAIAssistant.exe và ScreenAIAssistant.dll triệt để trên Windows (MSB3021 / MSB3026):
    1. Tự động đóng tiến trình ScreenAIAssistant.exe cũ trước khi bắt đầu biên dịch.
    2. Nếu tiến trình bị giữ khóa, cơ chế NTFS Rename đổi tên cả .exe và .dll sang .old để giải phóng đường dẫn cho MSBuild chép file mới.
  -->
  <Target Name="UnlockRunningExeBeforeCopy" BeforeTargets="BeforeBuild;PrepareForBuild;CopyFilesToOutputDirectory;_CopyAppHost">
    <Exec Command="taskkill /F /IM ScreenAIAssistant.exe /T &gt;nul 2&gt;&amp;1 || exit /b 0" IgnoreExitCode="true" />
    <Exec Command="if exist &quot;$(TargetDir)ScreenAIAssistant.old.exe&quot; del /F /Q &quot;$(TargetDir)ScreenAIAssistant.old.exe&quot; &gt;nul 2&gt;&amp;1" IgnoreExitCode="true" />
    <Exec Command="if exist &quot;$(TargetDir)ScreenAIAssistant.old.dll&quot; del /F /Q &quot;$(TargetDir)ScreenAIAssistant.old.dll&quot; &gt;nul 2&gt;&amp;1" IgnoreExitCode="true" />
    <Exec Command="if exist &quot;$(TargetDir)ScreenAIAssistant.exe&quot; move /Y &quot;$(TargetDir)ScreenAIAssistant.exe&quot; &quot;$(TargetDir)ScreenAIAssistant.old.exe&quot; &gt;nul 2&gt;&amp;1" IgnoreExitCode="true" />
    <Exec Command="if exist &quot;$(TargetDir)ScreenAIAssistant.dll&quot; move /Y &quot;$(TargetDir)ScreenAIAssistant.dll&quot; &quot;$(TargetDir)ScreenAIAssistant.old.dll&quot; &gt;nul 2&gt;&amp;1" IgnoreExitCode="true" />
  </Target>

</Project>
