<UserControl x:Class="ScreenAIAssistant.Views.AiAssistantTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="250"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*" MinWidth="480"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: DANH SÁCH LỊCH SỬ HỎI AI ĐÃ LƯU -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="🕒 Lịch Sử Hỏi AI Của Môn"
                           Style="{StaticResource SectionTitleTextStyle}"
                           Margin="0,0,0,6"/>
                <TextBlock DockPanel.Dock="Top"
                           Text="Mọi câu hỏi và giải thích của AI đều được lưu lại tại đây để bạn tra cứu lại bất cứ lúc nào."
                           Style="{StaticResource MutedTextStyle}"
                           Margin="0,0,0,10"/>

                <!-- Tìm kiếm trong lịch sử hỏi AI -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding AiSearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="🔍 Tìm trong lịch sử hỏi AI..."
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AiSearchKeyword}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Trạng thái trống khi chưa có lịch sử hỏi AI -->
                <Border DockPanel.Dock="Top"
                        Style="{StaticResource PlaceholderBorderStyle}"
                        Visibility="{Binding HasAiHistory, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🤖" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Chưa có lịch sử hỏi AI"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Hãy đặt câu hỏi ở khung bên phải. Toàn bộ lịch sử hỏi đáp của môn học sẽ được lưu tại đây."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Danh sách các lần hỏi AI -->
                <ListBox ItemsSource="{Binding AiHistoryItems}"
                         SelectedItem="{Binding SelectedAiHistory, Mode=TwoWay}"
                         Visibility="{Binding HasAiHistory, Converter={StaticResource BoolToVisibilityConverter}}"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="AiItemBorder"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12,10">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="AiItemBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="AiItemBorder" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                                <Setter TargetName="AiItemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter TargetName="AiItemBorder" Property="BorderThickness" Value="1.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <Border DockPanel.Dock="Left"
                                            Background="{DynamicResource PrimaryBrush}"
                                            CornerRadius="5"
                                            Padding="7,2">
                                        <TextBlock Text="{Binding ModeName}"
                                                   Foreground="White"
                                                   FontSize="10.5"
                                                   FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding CreatedAtText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="10"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      Cursor="SizeWE"/>

        <!-- VÙNG CHÍNH BÊN PHẢI: KHUNG ĐẶT CÂU HỎI MỚI & XEM CHI TIẾT LỊCH SỬ HỎI AI -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Khung 1: Đặt câu hỏi mới cho Trợ lý AI -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="18">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right"
                                Content="📄 Lấy nội dung trang tài liệu đang mở"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="32" Padding="12,5" FontSize="12"
                                Command="{Binding UseCurrentDocumentPageForAiCommand}"/>
                        <TextBlock Text="🤖 Đặt Câu Hỏi Cho Trợ Lý AI"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding AiModes}"
                                  SelectedItem="{Binding SelectedAiMode}"
                                  Height="38"
                                  VerticalContentAlignment="Center"
                                  Padding="10,0"/>

                        <TextBox Grid.Column="2"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding AiPromptInput, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="52"/>

                        <Button Grid.Column="4"
                                Content="✨ Hỏi AI &amp; Lưu Lịch Sử"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AskAiAndSaveHistoryCommand}"
                                VerticalAlignment="Stretch"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Khung 2: Chi tiết Câu hỏi & Câu trả lời của AI từ lịch sử -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="18">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="📌 Ghim thành Note lên Bảng Blueprint"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinHeight="34" Padding="14,6" FontSize="12"
                                    Command="{Binding PinAiHistoryToCanvasCommand}"
                                    Margin="0,0,8,0"/>
                            <Button Content="💾 Lưu chỉnh sửa"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinHeight="34" Padding="12,6" FontSize="12"
                                    Command="{Binding SaveEditedAiHistoryCommand}"
                                    Margin="0,0,8,0"/>
                            <Button Content="🗑️ Xóa"
                                    Style="{StaticResource DangerButtonStyle}"
                                    MinHeight="34" Padding="12,6" FontSize="12"
                                    Command="{Binding DeleteSelectedAiHistoryCommand}"/>
                        </WrapPanel>

                        <TextBlock Text="📋 Chi Tiết Nội Dung Hỏi Đáp Trong Lịch Sử"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="❓ Câu hỏi / Nội dung bạn đã gửi:"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding SelectedAiQuestionDetail, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="68"
                                     Margin="0,0,0,14"/>

                            <TextBlock Text="💡 Phản hồi &amp; Giải thích của Trợ lý AI:"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding SelectedAiAnswerDetail, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="190"
                                     VerticalContentAlignment="Top"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
