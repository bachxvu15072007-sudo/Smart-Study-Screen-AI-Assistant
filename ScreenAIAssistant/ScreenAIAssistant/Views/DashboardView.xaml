<UserControl x:Class="ScreenAIAssistant.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:ScreenAIAssistant.ViewModels"
             xmlns:helpers="clr-namespace:ScreenAIAssistant.Helpers"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- 3 Thẻ số liệu WrapPanel -->
                <RowDefinition Height="*" />    <!-- Danh sách môn học + Form CRUD -->
            </Grid.RowDefinitions>

            <!-- 1. TIÊU ĐỀ TRANG & THÔNG BÁO -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Tổng Quan &amp; Quản Lý Môn Học"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Theo dõi tiến độ học tập toàn diện và quản lý danh mục môn học của bạn"
                           FontSize="13" Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />

                <!-- Cảnh báo lỗi (Validation) -->
                <Border Background="#FEE2E2" BorderBrush="#F87171" BorderThickness="1"
                        CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontWeight="SemiBold" FontSize="13" />
                </Border>

                <!-- Thông báo trạng thái thành công -->
                <Border Background="#DCFCE7" BorderBrush="#4ADE80" BorderThickness="1"
                        CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                        Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#166534" FontWeight="SemiBold" FontSize="13" />
                </Border>
            </StackPanel>

            <!-- 2. KHU VỰC 3 THẺ SỐ LIỆU TỔNG QUAN (WrapPanel co giãn responsive - Tiêu chí 2) -->
            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                
                <!-- Thẻ 1: Tổng số Môn học -->
                <Border Style="{StaticResource StatCardBorderStyle}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="📚 TỔNG SỐ MÔN HỌC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding TotalSubjects}" FontSize="28" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="Đang theo học và lưu trữ" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Thẻ 2: Tổng số Ghi chú OCR -->
                <Border Style="{StaticResource StatCardBorderStyle}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="📝 GHI CHÚ CHỤP MÀN HÌNH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding TotalNotes}" FontSize="28" FontWeight="ExtraBold" Foreground="#059669" Margin="0,4,0,0" />
                            <TextBlock Text="Đã trích xuất chữ OCR &amp; AI" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Thẻ 3: Tổng số Thẻ Flashcard & Tỷ lệ thuộc -->
                <Border Style="{StaticResource StatCardBorderStyle}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="🎯 THẺ FLASHCARD ÔN TẬP" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                                <TextBlock Text="{Binding TotalFlashcards}" FontSize="28" FontWeight="ExtraBold" Foreground="#7C3AED" />
                                <TextBlock Text=" thẻ" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4" />
                            </StackPanel>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="Đã thuộc: " />
                                <Run Text="{Binding MasteredFlashcards, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                                <Run Text=" (" />
                                <Run Text="{Binding OverallMasteryRate, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                                <Run Text="%)" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

            </WrapPanel>

            <!-- 3. KHU VỰC CHI TIẾT: DANH SÁCH MÔN HỌC & FORM CRUD (Grid 2 cột) -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="340" />
                    <ColumnDefinition Width="16" /> <!-- Khoảng cách giữa 2 cột -->
                    <ColumnDefinition Width="2*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI: DANH SÁCH MÔN HỌC & TIẾN ĐỘ PROGRESSBAR -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header Danh sách -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Danh Sách Môn Học &amp; Tiến Độ"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button Content="🔄 Tải lại"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="32" Padding="10,0" FontSize="12"
                                    Command="{Binding LoadDashboardDataCommand}" />
                        </DockPanel>

                        <!-- Danh sách Môn học -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding SubjectList}"
                                 SelectedItem="{Binding SelectedSubjectProgress}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="itemBorder"
                                                        Background="#F8FAFC"
                                                        BorderBrush="{StaticResource BorderLightBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="14,12">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="#F1F5F9" />
                                                        <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource PrimaryLightBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="#EFF6FF" />
                                                        <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                        <Setter TargetName="itemBorder" Property="BorderThickness" Value="1.5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <!-- DataTemplate hiển thị thẻ Môn học + ProgressBar -->
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Hàng 1: Tên môn học + Màu sắc -->
                                        <DockPanel Grid.Row="0">
                                            <Border Width="12" Height="12" CornerRadius="6"
                                                    Background="{Binding Subject.ColorHex}"
                                                    Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Subject.Name}"
                                                       FontWeight="Bold" FontSize="14"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Text="{Binding NotesCount, StringFormat='📝 {0} ghi chú'}"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>

                                        <!-- Hàng 2: Mô tả môn học -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Subject.Description}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="20,4,0,8" />

                                        <!-- Hàng 3: Thanh ProgressBar chuẩn WPF (ControlTemplate bo tròn góc) -->
                                        <Grid Grid.Row="2" Margin="20,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ProgressBar Grid.Row="0"
                                                         Style="{StaticResource ModernRoundedProgressBarStyle}"
                                                         Value="{Binding MasteryPercentage}"
                                                         Maximum="100" />
                                            <DockPanel Grid.Row="1" Margin="0,4,0,0">
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="Thẻ nhớ: " />
                                                    <Run Text="{Binding MasteredCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                                    <Run Text="/" />
                                                    <Run Text="{Binding FlashcardsCount, Mode=OneWay}" />
                                                    <Run Text=" đã thuộc" />
                                                </TextBlock>
                                                <TextBlock HorizontalAlignment="Right"
                                                           Text="{Binding MasteryPercentage, StringFormat='{}{0}%'}"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryBrush}" />
                                            </DockPanel>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- CỘT PHẢI: FORM THÊM MỚI / SỬA / XÓA MÔN HỌC (CRUD) -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <!-- Form Header -->
                        <TextBlock FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="➕ Thêm Môn Học Mới" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Text" Value="✏️ Chỉnh Sửa Môn Học" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Nhập thông tin môn học và chọn mã màu hiển thị"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />

                        <!-- Tên Môn Học -->
                        <TextBlock Text="Tên môn học (*):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,14" />

                        <!-- Bảng màu sắc gợi ý -->
                        <TextBlock Text="Màu đại diện:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding ColorPalette}" Margin="0,0,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="26" Height="26" Margin="0,0,8,0"
                                            Background="{Binding}"
                                            Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="13"
                                                        BorderBrush="{StaticResource BorderLightBrush}"
                                                        BorderThickness="1.5" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Mô tả Môn Học -->
                        <TextBlock Text="Mô tả / Ghi chú môn học:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding DescriptionInput, UpdateSourceTrigger=PropertyChanged}"
                                 Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top" Padding="8"
                                 Margin="0,0,0,18" />

                        <!-- Các Nút Hành Động CRUD -->
                        <Button Content="💾 Lưu Môn Học"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveSubjectCommand}"
                                Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="🔄 Làm mới"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ResetFormCommand}" />
                            <Button Grid.Column="2" Content="🗑️ Xóa môn"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DeleteSubjectCommand}"
                                    IsEnabled="{Binding IsEditing}" />
                        </Grid>
                    </StackPanel>
                </Border>

            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
