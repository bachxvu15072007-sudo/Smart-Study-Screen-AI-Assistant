<UserControl x:Class="ScreenAIAssistant.Views.SubjectWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:ScreenAIAssistant.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1280"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <!-- Họa tiết lưới mảnh trên nền trong suốt (để Bảng Blueprint dùng chung màu nền AppBackgroundBrush) -->
        <DrawingBrush x:Key="BlueprintGridBrush"
                      TileMode="Tile"
                      Viewport="0,0,100,100"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,100,100"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <!-- Lưới phụ (Minor Grid 20x20) -->
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#1464748B" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,20" EndPoint="100,20"/>
                                <LineGeometry StartPoint="0,40" EndPoint="100,40"/>
                                <LineGeometry StartPoint="0,60" EndPoint="100,60"/>
                                <LineGeometry StartPoint="0,80" EndPoint="100,80"/>
                                <LineGeometry StartPoint="20,0" EndPoint="20,100"/>
                                <LineGeometry StartPoint="40,0" EndPoint="40,100"/>
                                <LineGeometry StartPoint="60,0" EndPoint="60,100"/>
                                <LineGeometry StartPoint="80,0" EndPoint="80,100"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <!-- Lưới chính (Major Grid 100x100) -->
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#2864748B" Thickness="1.2"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="100,0"/>
                                <LineGeometry StartPoint="0,0" EndPoint="0,100"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- 1. THANH TIÊU ĐỀ MÔN HỌC + CHẾ ĐỘ BẮT ĐẦU HỌC TẬP + THANH TASKBAR TAB     -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="20,14"
                Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Left"
                            Content="⬅️ Danh sách Môn học"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding GoBackCommand}"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"/>

                    <!-- CỤM PHẢI: CHẾ ĐỘ BẮT ĐẦU HỌC TẬP & THÊM TÀI LIỆU -->
                    <WrapPanel DockPanel.Dock="Right"
                               Orientation="Horizontal"
                               VerticalAlignment="Center">

                        <!-- Khi CHƯA bắt đầu học: Hiển thị nút Bắt đầu học tập -->
                        <Button Content="▶️ Bắt đầu học tập"
                                Command="{Binding StartStudySessionCommand}"
                                Visibility="{Binding IsStudying, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                Background="#0F9D8F"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="13"
                                MinHeight="38"
                                Padding="16,8"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="StartBtnBorder"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="9"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="StartBtnBorder" Property="Background" Value="#0D8A7E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Khi ĐANG HỌC TẬP: Hiển thị đồng hồ trực tiếp + Nút Kết thúc phiên học -->
                        <Border Background="{DynamicResource AccentTealLightBrush}"
                                BorderBrush="{DynamicResource AccentTealBrush}"
                                BorderThickness="1.5"
                                CornerRadius="9"
                                Padding="12,6"
                                Margin="0,0,10,0"
                                Visibility="{Binding IsStudying, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🟢 ĐANG HỌC:"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentTealBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding LiveTimerText}"
                                           FontSize="15"
                                           FontWeight="ExtraBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <Button Content="⏹️ Kết thúc &amp; Lưu giờ học"
                                        Command="{Binding StopStudySessionCommand}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        MinHeight="30"
                                        Padding="12,4"
                                        FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Button Content="📂 + Thêm Tài liệu"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ImportDocumentFileCommand}"
                                Margin="0,0,8,0"/>

                        <Button Content="↗️ Mở file gốc"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenDocumentExternalCommand}"/>
                    </WrapPanel>

                    <!-- Thông tin Môn học & Trạng thái Ngày giờ bắt đầu - kết thúc -->
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="13" Height="13"
                                    CornerRadius="7"
                                    Background="{Binding ActiveSubject.ColorHex, Converter={StaticResource StringToBrushConverter}}"
                                    Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding ActiveSubject.Name}"
                                       FontSize="18.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,12,0"/>
                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SubjectTotalStudyTimeText}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTealBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding SessionTimeInfoText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="23,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>

                <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,8"/>

                <!-- THANH TASKBAR CỦA MÔN HỌC: "Tài Liệu & Bảng Blueprint" và "Trợ Lý AI" -->
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding StatusMessage}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentTealBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="📐 Tài Liệu &amp; Bảng Blueprint"
                                     Style="{StaticResource WorkspaceTabRadioStyle}"
                                     IsChecked="{Binding SelectedTab, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=Documents, Mode=TwoWay}"/>
                        <RadioButton Content="🤖 Trợ Lý AI (Lịch Sử Hỏi AI)"
                                     Style="{StaticResource WorkspaceTabRadioStyle}"
                                     IsChecked="{Binding SelectedTab, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=AI, Mode=TwoWay}"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 2. KHUNG BÁO LỖI (NẾU CÓ) -->
        <Border Grid.Row="1"
                Background="{DynamicResource DangerLightBrush}"
                BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,8"
                Margin="0,0,0,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource DangerBrush}"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- ========================================================================= -->
        <!-- TAB 1: TÀI LIỆU & BẢNG BLUEPRINT HỌC TẬP (KÉO THẢ NOTE PINNED TỰ DO)     -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="2"
              Visibility="{Binding SelectedTab, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Documents}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285" MinWidth="230"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="560"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: Danh sách Tài liệu của môn + Biểu đồ Thời gian Tự học Qua Từng Ngày -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.15*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="1.05*"/>
                </Grid.RowDefinitions>

                <!-- Ô trên: Danh sách Tài liệu -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="📁 Tài Liệu Của Môn"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   Margin="0,0,0,8"/>

                        <!-- Bộ lọc định dạng -->
                        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Tất cả"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinHeight="28" Padding="9,3" FontSize="11" Margin="0,0,5,5"
                                    Command="{Binding FilterDocumentFormatCommand}" CommandParameter="ALL"/>
                            <Button Content="📕 PDF"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinHeight="28" Padding="9,3" FontSize="11" Margin="0,0,5,5"
                                    Command="{Binding FilterDocumentFormatCommand}" CommandParameter="PDF"/>
                            <Button Content="📘 Word"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinHeight="28" Padding="9,3" FontSize="11" Margin="0,0,5,5"
                                    Command="{Binding FilterDocumentFormatCommand}" CommandParameter="WORD"/>
                            <Button Content="📙 PPT"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinHeight="28" Padding="9,3" FontSize="11" Margin="0,0,0,5"
                                    Command="{Binding FilterDocumentFormatCommand}" CommandParameter="PPT"/>
                        </WrapPanel>

                        <!-- Ô tìm kiếm file -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding DocumentSearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="🔍 Tìm tài liệu..."
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DocumentSearchKeyword}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Trạng thái trống khi môn học mới tạo chưa có tài liệu -->
                        <Border DockPanel.Dock="Top"
                                Style="{StaticResource PlaceholderBorderStyle}"
                                Padding="12"
                                Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📭 Chưa có tài liệu"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Bấm nút bên dưới để thêm PDF, Word, PPT lên Bảng Blueprint."
                                           Style="{StaticResource MutedTextStyle}"
                                           TextAlignment="Center"
                                           Margin="0,0,0,10"/>
                                <Button Content="📂 + Chọn File"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ImportDocumentFileCommand}"
                                        HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Danh sách file đã lưu -->
                        <ListBox ItemsSource="{Binding SubjectDocuments}"
                                 SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                                 Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,7"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="DocBorder"
                                                        Background="{DynamicResource SurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9"
                                                        Padding="10,8">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="DocBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="DocBorder" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                                        <Setter TargetName="DocBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Setter TargetName="DocBorder" Property="BorderThickness" Value="1.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,3">
                                            <Border DockPanel.Dock="Left"
                                                    Background="{Binding BadgeColor, Converter={StaticResource StringToBrushConverter}}"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    Margin="0,0,6,0">
                                                <TextBlock Text="{Binding BadgeText}"
                                                           Foreground="White"
                                                           FontSize="10"
                                                           FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding CreatedAtText}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,2"/>
                                        <TextBlock Text="{Binding InfoText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Ô dưới: BIỂU ĐỒ THỜI GIAN TỰ HỌC QUA TỪNG NGÀY CỦA MÔN HỌC -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="📊 Biểu Đồ Tự Học Theo Ngày"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DockPanel>

                        <!-- Biểu đồ cột 7 ngày gần nhất -->
                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8,10,8,8"
                                Margin="0,0,0,8">
                            <ItemsControl ItemsSource="{Binding SubjectDailyStudyChart}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Bottom"
                                                    ToolTip="{Binding TooltipText}"
                                                    Margin="1,0">
                                            <TextBlock Text="{Binding TimeValueText}"
                                                       FontSize="9.5"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,4"/>
                                            <Grid Height="84" VerticalAlignment="Bottom">
                                                <Border Width="18"
                                                        Height="84"
                                                        CornerRadius="5"
                                                        Background="{DynamicResource CardBorderBrush}"
                                                        Opacity="0.28"
                                                        VerticalAlignment="Bottom"/>
                                                <Border Width="18"
                                                        Height="{Binding BarHeight}"
                                                        CornerRadius="5"
                                                        Background="{Binding BarColorHex, Converter={StaticResource StringToBrushConverter}}"
                                                        VerticalAlignment="Bottom"/>
                                            </Grid>
                                            <TextBlock Text="{Binding DayLabel}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding DateSubLabel}"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Danh sách ngắn ngày giờ bắt đầu - kết thúc bên dưới biểu đồ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SubjectStudySessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="8,5"
                                                Margin="0,0,0,5">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding DurationFormatted}"
                                                           FontSize="10.5"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentTealBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ShortTimeRangeText}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE"/>

            <!-- VÙNG CHÍNH: BẢNG BLUEPRINT HỌC TẬP (CHỨA TÀI LIỆU & CÁC NOTE PINNED KÉO THẢ TỰ DO) -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                <DockPanel>
                    <!-- Thanh điều khiển Bảng Blueprint -->
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,8"
                            Margin="0,0,0,12">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Nút bấm mở cửa sổ Popup điền Mặt trước & Mặt sau -->
                                <Button Content="📌 + Ghim Flashcard / Note"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinHeight="32" Padding="14,5" FontSize="12"
                                        Command="{Binding TogglePinFormCommand}"
                                        Margin="0,0,10,0"/>

                                <Button Content="◀"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinHeight="32" Width="34" Padding="0"
                                        Command="{Binding PreviousCanvasPageCommand}"
                                        Margin="0,0,6,0"/>
                                <Border Background="{DynamicResource CardBgBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,5"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PageIndicatorText}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Border>
                                <Button Content="▶"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinHeight="32" Width="34" Padding="0"
                                        Command="{Binding NextCanvasPageCommand}"
                                        Margin="0,0,10,0"/>

                                <Button Content="➖"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinHeight="32" Width="32" Padding="0"
                                        Command="{Binding ZoomOutCanvasCommand}"
                                        Margin="0,0,4,0"/>
                                <Button Content="{Binding CanvasZoomPercentText}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinHeight="32" Padding="10,4" FontSize="11.5"
                                        Command="{Binding ResetCanvasZoomCommand}"
                                        Margin="0,0,4,0"/>
                                <Button Content="➕"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinHeight="32" Width="32" Padding="0"
                                        Command="{Binding ZoomInCanvasCommand}"
                                        Margin="0,0,10,0"/>

                                <Button Content="🗑️"
                                        Style="{StaticResource DangerButtonStyle}"
                                        MinHeight="32" Width="34" Padding="0"
                                        ToolTip="Xóa tài liệu đang mở"
                                        Command="{Binding DeleteSelectedDocumentCommand}"/>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{Binding SelectedDocument.BadgeColor, Converter={StaticResource StringToBrushConverter}, FallbackValue=#2F6FEB}"
                                        CornerRadius="5"
                                        Padding="8,2"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SelectedDocument.BadgeText, FallbackValue='📐 BLUEPRINT'}"
                                               Foreground="White"
                                               FontSize="11"
                                               FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedDocument.Title, FallbackValue='Bảng Blueprint Học Tập &amp; Ghim Note'}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- MẶT BẢNG BLUEPRINT HỌC TẬP (CÙNG MÀU VỚI MÀU NỀN + CON TRỎ BÀN TAY KÉO BẢNG + CTRL LĂN CHUỘT ZOOM) -->
                    <Border Background="{DynamicResource AppBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            ClipToBounds="True">
                        <Grid Background="{StaticResource BlueprintGridBrush}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="12"
                                          Cursor="Hand"
                                          helpers:CanvasDragHelper.EnableBoardPanAndZoom="True">
                                <Canvas Width="1480"
                                        Height="{Binding BoardCanvasHeight, FallbackValue=1040}"
                                        Background="Transparent"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top">
                                    <Canvas.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding CanvasZoom}"
                                                        ScaleY="{Binding CanvasZoom}"/>
                                    </Canvas.LayoutTransform>

                                    <!-- =============================================================== -->
                                    <!-- 1. KHUNG TÀI LIỆU ĐẶT TRÊN MẶT BẢNG BLUEPRINT                   -->
                                    <!-- =============================================================== -->
                                    <Border Canvas.Left="28"
                                            Canvas.Top="24"
                                            Width="710"
                                            MinHeight="{Binding CurrentCanvasPage.CanvasHeight, FallbackValue=880}"
                                            Background="#FFFFFF"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="6">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.45"/>
                                    </Border.Effect>
                                    <Grid>
                                        <!-- Khi môn học chưa có tài liệu -->
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    MaxWidth="420"
                                                    Margin="24"
                                                    Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                            <TextBlock Text="📄 Đặt Tài Liệu Lên Bảng Blueprint"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       Foreground="#0F172A"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Text="Hãy bấm nút bên dưới để mở file PDF, Word (.docx) hoặc Slide PowerPoint (.pptx) lên mặt bảng Blueprint. Bạn có thể bấm nút '📌 + Ghim Flashcard / Note' để đính các tờ Note lưu ý và kéo thả tự do quanh tài liệu."
                                                       FontSize="13"
                                                       Foreground="#475569"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,16"/>
                                            <Button Content="📂 + Thêm Tài liệu (PDF / Word / PPT)"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding ImportDocumentFileCommand}"
                                                    HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Khi đã có tài liệu đang mở -->
                                        <DockPanel LastChildFill="True"
                                                   Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border DockPanel.Dock="Top"
                                                    Background="{Binding CurrentCanvasPage.AccentColor, Converter={StaticResource StringToBrushConverter}, FallbackValue=#2F6FEB}"
                                                    CornerRadius="4,4,0,0"
                                                    Padding="16,8">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left"
                                                               Text="{Binding CurrentCanvasPage.PageLabel}"
                                                               Foreground="White"
                                                               FontSize="12"
                                                               FontWeight="Bold"/>
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Text="{Binding CurrentCanvasPage.Title}"
                                                               Foreground="#F8FAFC"
                                                               FontSize="12"
                                                               HorizontalAlignment="Right"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </Border>

                                            <StackPanel Margin="20,16">
                                                <Image Source="{Binding CurrentCanvasPage.PageImage}"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding CurrentCanvasPage.HasPageImage, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       Margin="0,0,0,12"/>

                                                <StackPanel Visibility="{Binding CurrentCanvasPage.HasTextContent, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding CurrentCanvasPage.Title}"
                                                               FontSize="17"
                                                               FontWeight="Bold"
                                                               Foreground="#0F172A"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,10"/>
                                                    <Separator Background="#CBD5E1" Margin="0,0,0,12"/>
                                                    <TextBox Text="{Binding CurrentCanvasPage.Content, Mode=OneWay}"
                                                             IsReadOnly="True"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             FontSize="14"
                                                             Foreground="#1E293B"
                                                             TextWrapping="Wrap"
                                                             AcceptsReturn="True"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Grid>
                                </Border>

                                <!-- =============================================================== -->
                                <!-- 2. LỚP CÁC THẺ FLASHCARD / NOTE PINNED KÉO THẢ KHẮP BLUEPRINT   -->
                                <!-- =============================================================== -->
                                <ItemsControl Canvas.Left="0"
                                              Canvas.Top="0"
                                              Width="1480"
                                              Height="{Binding BoardCanvasHeight, FallbackValue=1040}"
                                              ItemsSource="{Binding PinnedFlashcards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Background="Transparent"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding CanvasX, Mode=TwoWay}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding CanvasY, Mode=TwoWay}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Thiết kế tờ giấy Note Pinned có đinh ghim 📌 ở đỉnh, nắm kéo đi khắp bảng -->
                                            <Grid Width="265"
                                                  helpers:CanvasDragHelper.EnableDrag="True"
                                                  Cursor="SizeAll"
                                                  ToolTip="Nắm chuột kéo tờ Note này đi bất kỳ đâu trên Bảng Blueprint">

                                                <!-- Thân tờ giấy Note ghim -->
                                                <Border Margin="0,10,0,0"
                                                        Background="{Binding NotePaperColorHex, Converter={StaticResource StringToBrushConverter}, FallbackValue=#FEF9C3}"
                                                        BorderBrush="#94A3B8"
                                                        BorderThickness="1.2"
                                                        CornerRadius="4,4,10,10"
                                                        Padding="13,16,13,12">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="5" Opacity="0.42"/>
                                                    </Border.Effect>

                                                    <StackPanel>
                                                        <!-- Thanh đầu tờ Note: Trạng thái thuộc bài + Nút gỡ ghim -->
                                                        <DockPanel Margin="0,0,0,8">
                                                            <Button DockPanel.Dock="Right"
                                                                    Content="✕"
                                                                    ToolTip="Gỡ ghim tờ Note này"
                                                                    Command="{Binding DataContext.UnpinFlashcardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="#EF4444"
                                                                    Foreground="White"
                                                                    FontWeight="Bold"
                                                                    FontSize="10"
                                                                    Width="22"
                                                                    Height="22"
                                                                    BorderThickness="0"
                                                                    Cursor="Hand">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="11">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>

                                                            <Button DockPanel.Dock="Left"
                                                                    Content="{Binding PinBadgeText}"
                                                                    ToolTip="Bấm để đổi trạng thái: Note ghim → Đang ôn → Đã thuộc"
                                                                    Command="{Binding DataContext.CyclePinnedCardMasteryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="{Binding PinThumbColor, Converter={StaticResource StringToBrushConverter}}"
                                                                    Foreground="White"
                                                                    FontSize="10.5"
                                                                    FontWeight="Bold"
                                                                    Padding="8,2"
                                                                    BorderThickness="0"
                                                                    Cursor="Hand">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </DockPanel>

                                                        <!-- Mặt trước: Câu hỏi / Tiêu đề lưu ý -->
                                                        <TextBlock Text="{Binding Question}"
                                                                   FontSize="13.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="#0F172A"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,0,0,6"/>

                                                        <Border Height="1" Background="#CBD5E1" Margin="0,0,0,6"/>

                                                        <!-- Mặt sau: Đáp án / Nội dung ghi chú lưu ý -->
                                                        <Border Background="#FFFFFF"
                                                                Opacity="0.88"
                                                                CornerRadius="6"
                                                                Padding="9,7"
                                                                Margin="0,0,0,8"
                                                                Visibility="{Binding IsAnswerVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding Answer}"
                                                                       FontSize="12.5"
                                                                       Foreground="#1E293B"
                                                                       TextWrapping="Wrap"/>
                                                        </Border>

                                                        <!-- Nút lật mặt sau + gợi ý kéo thả -->
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="✥ Kéo di chuyển"
                                                                       FontSize="10"
                                                                       Foreground="#475569"
                                                                       VerticalAlignment="Center"/>

                                                            <Button Content="{Binding FlipButtonText}"
                                                                    Command="{Binding DataContext.FlipPinnedCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="#0F172A"
                                                                    Foreground="#F8FAFC"
                                                                    FontSize="10.5"
                                                                    FontWeight="SemiBold"
                                                                    Padding="8,3"
                                                                    BorderThickness="0"
                                                                    HorizontalAlignment="Left"
                                                                    Cursor="Hand">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Đinh ghim tròn 3D (Pushpin 📌) ở chính giữa đỉnh tờ Note -->
                                                <Border Width="24"
                                                        Height="24"
                                                        CornerRadius="12"
                                                        Background="{Binding PinThumbColor, Converter={StaticResource StringToBrushConverter}}"
                                                        BorderBrush="#FFFFFF"
                                                        BorderThickness="2"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Top">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.5"/>
                                                    </Border.Effect>
                                                    <TextBlock Text="📌"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </ScrollViewer>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- TAB 2: TRỢ LÝ AI (LƯU TRỮ LỊCH SỬ HỎI AI CỦA MÔN HỌC)                     -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="2"
              Visibility="{Binding SelectedTab, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=AI}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="480"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: DANH SÁCH LỊCH SỬ HỎI AI ĐÃ LƯU -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="🕒 Lịch Sử Hỏi AI Của Môn"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,6"/>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Mọi câu hỏi và giải thích của AI đều được lưu lại tại đây để bạn tra cứu lại bất cứ lúc nào."
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,0,0,10"/>

                    <!-- Tìm kiếm trong lịch sử hỏi AI -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding AiSearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="🔍 Tìm trong lịch sử hỏi AI..."
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AiSearchKeyword}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Trạng thái trống khi chưa có lịch sử hỏi AI -->
                    <Border DockPanel.Dock="Top"
                            Style="{StaticResource PlaceholderBorderStyle}"
                            Visibility="{Binding HasAiHistory, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🤖" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Chưa có lịch sử hỏi AI"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Hãy đặt câu hỏi ở khung bên phải. Toàn bộ lịch sử hỏi đáp của môn học sẽ được lưu tại đây."
                                       Style="{StaticResource MutedTextStyle}"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Danh sách các lần hỏi AI -->
                    <ListBox ItemsSource="{Binding AiHistoryItems}"
                             SelectedItem="{Binding SelectedAiHistory, Mode=TwoWay}"
                             Visibility="{Binding HasAiHistory, Converter={StaticResource BoolToVisibilityConverter}}"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="AiItemBorder"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12,10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="AiItemBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="AiItemBorder" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                                    <Setter TargetName="AiItemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter TargetName="AiItemBorder" Property="BorderThickness" Value="1.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <Border DockPanel.Dock="Left"
                                                Background="{DynamicResource PrimaryBrush}"
                                                CornerRadius="5"
                                                Padding="7,2">
                                            <TextBlock Text="{Binding ModeName}"
                                                       Foreground="White"
                                                       FontSize="10.5"
                                                       FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding CreatedAtText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE"/>

            <!-- VÙNG CHÍNH BÊN PHẢI: KHUNG ĐẶT CÂU HỎI MỚI & XEM CHI TIẾT LỊCH SỬ HỎI AI -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Khung 1: Đặt câu hỏi mới cho Trợ lý AI -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="18">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right"
                                    Content="📄 Lấy nội dung trang tài liệu đang mở"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinHeight="32" Padding="12,5" FontSize="12"
                                    Command="{Binding UseCurrentDocumentPageForAiCommand}"/>
                            <TextBlock Text="🤖 Đặt Câu Hỏi Cho Trợ Lý AI"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AiModes}"
                                      SelectedItem="{Binding SelectedAiMode}"
                                      Height="38"
                                      VerticalContentAlignment="Center"
                                      Padding="10,0"/>

                            <TextBox Grid.Column="2"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding AiPromptInput, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="52"/>

                            <Button Grid.Column="4"
                                    Content="✨ Hỏi AI &amp; Lưu Lịch Sử"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AskAiAndSaveHistoryCommand}"
                                    VerticalAlignment="Stretch"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Khung 2: Chi tiết Câu hỏi & Câu trả lời của AI từ lịch sử -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="18">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="📌 Ghim thành Note lên Bảng Blueprint"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinHeight="34" Padding="14,6" FontSize="12"
                                        Command="{Binding PinAiHistoryToCanvasCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Content="💾 Lưu chỉnh sửa"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinHeight="34" Padding="12,6" FontSize="12"
                                        Command="{Binding SaveEditedAiHistoryCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Content="🗑️ Xóa"
                                        Style="{StaticResource DangerButtonStyle}"
                                        MinHeight="34" Padding="12,6" FontSize="12"
                                        Command="{Binding DeleteSelectedAiHistoryCommand}"/>
                            </WrapPanel>

                            <TextBlock Text="📋 Chi Tiết Nội Dung Hỏi Đáp Trong Lịch Sử"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="❓ Câu hỏi / Nội dung bạn đã gửi:"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding SelectedAiQuestionDetail, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="68"
                                         Margin="0,0,0,14"/>

                                <TextBlock Text="💡 Phản hồi &amp; Giải thích của Trợ lý AI:"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding SelectedAiAnswerDetail, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="190"
                                         VerticalContentAlignment="Top"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================================================= -->
        <!-- CỬA SỐ POPUP NỔI: TẠO & GHIM FLASHCARD / NOTE LÊN BẢNG BLUEPRINT           -->
        <!-- (Nhảy lên khi người dùng bấm nút '📌 + Ghim Flashcard / Note')            -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              Panel.ZIndex="999"
              Background="#88020617"
              Visibility="{Binding IsPinPopupOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Style="{StaticResource CardBorderStyle}"
                    Width="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource PrimaryBrush}"
                    BorderThickness="2"
                    Padding="24,20">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8" Opacity="0.6"/>
                </Border.Effect>

                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right"
                                Content="✕"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="30" Width="32" Padding="0"
                                Command="{Binding ClosePinPopupCommand}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📌 Tạo &amp; Ghim Flashcard Lên Bảng Blueprint"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Điền mặt trước và mặt sau bên dưới. Sau khi ghim, tờ Note sẽ xuất hiện trên Bảng Blueprint để bạn tự do kéo thả đến vị trí bất kỳ."
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,0,0,14"/>

                    <!-- Chọn màu giấy Note ghim -->
                    <TextBlock Text="🎨 Chọn màu giấy Note ghim:"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="Vàng Post-it"
                                Command="{Binding SelectNoteColorCommand}"
                                CommandParameter="#FEF9C3"
                                Background="#FEF9C3"
                                Foreground="#0F172A"
                                FontWeight="Bold"
                                FontSize="11.5"
                                Padding="10,5"
                                Margin="0,0,8,0"
                                Cursor="Hand"/>
                        <Button Content="Xanh Mint"
                                Command="{Binding SelectNoteColorCommand}"
                                CommandParameter="#DCFCE7"
                                Background="#DCFCE7"
                                Foreground="#0F172A"
                                FontWeight="Bold"
                                FontSize="11.5"
                                Padding="10,5"
                                Margin="0,0,8,0"
                                Cursor="Hand"/>
                        <Button Content="Xanh Lam"
                                Command="{Binding SelectNoteColorCommand}"
                                CommandParameter="#DBEAFE"
                                Background="#DBEAFE"
                                Foreground="#0F172A"
                                FontWeight="Bold"
                                FontSize="11.5"
                                Padding="10,5"
                                Margin="0,0,8,0"
                                Cursor="Hand"/>
                        <Button Content="Hồng Phấn"
                                Command="{Binding SelectNoteColorCommand}"
                                CommandParameter="#FCE7F3"
                                Background="#FCE7F3"
                                Foreground="#0F172A"
                                FontWeight="Bold"
                                FontSize="11.5"
                                Padding="10,5"
                                Cursor="Hand"/>
                    </StackPanel>

                    <!-- Ô nhập Mặt trước -->
                    <TextBlock Text="1. Mặt trước (Câu hỏi / Tiêu đề Note lưu ý):"
                               FontSize="12.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding NewPinQuestion, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,14"/>

                    <!-- Ô nhập Mặt sau -->
                    <TextBlock Text="2. Mặt sau (Đáp án / Nội dung ghi chú chi tiết):"
                               FontSize="12.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding NewPinAnswer, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="95"
                             VerticalContentAlignment="Top"
                             Margin="0,0,0,18"/>

                    <!-- Nút hành động -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClosePinPopupCommand}"
                                Margin="0,0,10,0"/>
                        <Button Content="📌 Ghim Lên Bảng Blueprint"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding PinFlashcardToCanvasCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
