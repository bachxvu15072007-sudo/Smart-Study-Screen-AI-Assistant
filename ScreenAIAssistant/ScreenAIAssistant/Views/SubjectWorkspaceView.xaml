<UserControl x:Class="ScreenAIAssistant.Views.SubjectWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:ScreenAIAssistant.Helpers"
             xmlns:local="clr-namespace:ScreenAIAssistant.Views"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1280"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <!-- Họa tiết lưới mảnh trên nền trong suốt (để Bảng Blueprint dùng chung màu nền AppBackgroundBrush) -->
        <DrawingBrush x:Key="BlueprintGridBrush"
                      TileMode="Tile"
                      Viewport="0,0,100,100"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,100,100"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <!-- Lưới phụ (Minor Grid 20x20) -->
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#1464748B" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,20" EndPoint="100,20"/>
                                <LineGeometry StartPoint="0,40" EndPoint="100,40"/>
                                <LineGeometry StartPoint="0,60" EndPoint="100,60"/>
                                <LineGeometry StartPoint="0,80" EndPoint="100,80"/>
                                <LineGeometry StartPoint="20,0" EndPoint="20,100"/>
                                <LineGeometry StartPoint="40,0" EndPoint="40,100"/>
                                <LineGeometry StartPoint="60,0" EndPoint="60,100"/>
                                <LineGeometry StartPoint="80,0" EndPoint="80,100"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <!-- Lưới chính (Major Grid 100x100) -->
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#2864748B" Thickness="1.2"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="100,0"/>
                                <LineGeometry StartPoint="0,0" EndPoint="0,100"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- 1. THANH TIÊU ĐỀ MÔN HỌC + CHẾ ĐỘ BẮT ĐẦU HỌC TẬP + THANH TASKBAR TAB     -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="20,14"
                Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Left"
                            Content="⬅️ Danh sách Môn học"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding GoBackCommand}"
                            AutomationProperties.Name="Quay lại danh sách môn học"
                            AutomationProperties.AutomationId="GoBackButton"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"/>

                    <!-- CỤM PHẢI: CHẾ ĐỘ BẮT ĐẦU HỌC TẬP & THÊM TÀI LIỆU -->
                    <WrapPanel DockPanel.Dock="Right"
                               Orientation="Horizontal"
                               VerticalAlignment="Center">

                        <!-- Khi CHƯA bắt đầu học: Hiển thị nút Bắt đầu học tập -->
                        <Button Content="▶️ Bắt đầu học tập"
                                Command="{Binding StartStudySessionCommand}"
                                AutomationProperties.Name="Bắt đầu học tập"
                                AutomationProperties.AutomationId="StartStudyButton"
                                Visibility="{Binding IsStudying, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                Background="#0F9D8F"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="13"
                                MinHeight="38"
                                Padding="16,8"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="StartBtnBorder"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="9"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="StartBtnBorder" Property="Background" Value="#0D8A7E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Khi ĐANG HỌC TẬP: Hiển thị đồng hồ trực tiếp + Nút Kết thúc phiên học -->
                        <Border Background="{DynamicResource AccentTealLightBrush}"
                                BorderBrush="{DynamicResource AccentTealBrush}"
                                BorderThickness="1.5"
                                CornerRadius="9"
                                Padding="12,6"
                                Margin="0,0,10,0"
                                Visibility="{Binding IsStudying, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🟢 ĐANG HỌC:"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentTealBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding LiveTimerText}"
                                           FontSize="15"
                                           FontWeight="ExtraBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <Button Content="⏹️ Kết thúc &amp; Lưu giờ học"
                                        Command="{Binding StopStudySessionCommand}"
                                        AutomationProperties.Name="Kết thúc và lưu giờ học"
                                        AutomationProperties.AutomationId="StopStudyButton"
                                        Style="{StaticResource DangerButtonStyle}"
                                        MinHeight="30"
                                        Padding="12,4"
                                        FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Button Content="📂 + Thêm Tài liệu"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ImportDocumentFileCommand}"
                                AutomationProperties.Name="Thêm tài liệu"
                                AutomationProperties.AutomationId="AddDocumentButton"
                                Margin="0,0,8,0"/>

                        <Button Content="↗️ Mở file gốc"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenDocumentExternalCommand}"
                                AutomationProperties.Name="Mở file gốc bằng ứng dụng ngoài"
                                AutomationProperties.AutomationId="OpenExternalHeaderButton"/>
                    </WrapPanel>

                    <!-- Thông tin Môn học & Trạng thái Ngày giờ bắt đầu - kết thúc -->
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="13" Height="13"
                                    CornerRadius="7"
                                    Background="{Binding ActiveSubject.ColorHex, Converter={StaticResource StringToBrushConverter}}"
                                    Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding ActiveSubject.Name}"
                                       FontSize="18.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,12,0"/>
                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SubjectTotalStudyTimeText}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTealBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding SessionTimeInfoText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="23,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>

                <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,8"/>

                <!-- THANH TASKBAR CỦA MÔN HỌC: "Tài Liệu & Bảng Blueprint" và "Trợ Lý AI" -->
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding StatusMessage}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentTealBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="📐 Tài Liệu &amp; Bảng Blueprint"
                                     Style="{StaticResource WorkspaceTabRadioStyle}"
                                     IsChecked="{Binding SelectedTab, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=Documents, Mode=TwoWay}"/>
                        <RadioButton Content="🤖 Trợ Lý AI (Lịch Sử Hỏi AI)"
                                     Style="{StaticResource WorkspaceTabRadioStyle}"
                                     IsChecked="{Binding SelectedTab, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=AI, Mode=TwoWay}"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 2. KHUNG BÁO LỖI (NẾU CÓ) -->
        <Border Grid.Row="1"
                Background="{DynamicResource DangerLightBrush}"
                BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,8"
                Margin="0,0,0,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource DangerBrush}"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- ========================================================================= -->
        <!-- TAB 1: TÀI LIỆU & BẢNG BLUEPRINT HỌC TẬP (KÉO THẢ NOTE PINNED TỰ DO)     -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="2"
              Visibility="{Binding SelectedTab, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Documents}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285" MinWidth="230"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="560"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: Danh sách Tài liệu của môn + Biểu đồ Thời gian Tự học Qua Từng Ngày -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.15*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="1.05*"/>
                </Grid.RowDefinitions>

                <!-- Ô trên: Danh sách Tài liệu -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="📁 Tài Liệu Của Môn"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   Margin="0,0,0,8"/>

                        <!-- Bộ lọc định dạng -->
                        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Tất cả"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinHeight="28" Padding="9,3" FontSize="11" Margin="0,0,5,5"
                                    Command="{Binding FilterDocumentFormatCommand}" CommandParameter="ALL"/>
                            <Button Content="📕 PDF"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinHeight="28" Padding="9,3" FontSize="11" Margin="0,0,5,5"
                                    Command="{Binding FilterDocumentFormatCommand}" CommandParameter="PDF"/>
                            <Button Content="📘 Word"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinHeight="28" Padding="9,3" FontSize="11" Margin="0,0,5,5"
                                    Command="{Binding FilterDocumentFormatCommand}" CommandParameter="WORD"/>
                            <Button Content="📙 PPT"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinHeight="28" Padding="9,3" FontSize="11" Margin="0,0,0,5"
                                    Command="{Binding FilterDocumentFormatCommand}" CommandParameter="PPT"/>
                        </WrapPanel>

                        <!-- Ô tìm kiếm file -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding DocumentSearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="🔍 Tìm tài liệu..."
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DocumentSearchKeyword}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Trạng thái trống khi môn học mới tạo chưa có tài liệu -->
                        <Border DockPanel.Dock="Top"
                                Style="{StaticResource PlaceholderBorderStyle}"
                                Padding="12"
                                Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📭 Chưa có tài liệu"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Bấm nút bên dưới để thêm PDF, Word, PPT lên Bảng Blueprint."
                                           Style="{StaticResource MutedTextStyle}"
                                           TextAlignment="Center"
                                           Margin="0,0,0,10"/>
                                <Button Content="📂 + Chọn File"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ImportDocumentFileCommand}"
                                        AutomationProperties.Name="Thêm tài liệu (trạng thái trống)"
                                        AutomationProperties.AutomationId="AddDocumentEmptyStateButton"
                                        HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Danh sách file đã lưu -->
                        <ListBox ItemsSource="{Binding SubjectDocuments}"
                                 SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                                 Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,7"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="DocBorder"
                                                        Background="{DynamicResource SurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9"
                                                        Padding="10,8">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="DocBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="DocBorder" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                                        <Setter TargetName="DocBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Setter TargetName="DocBorder" Property="BorderThickness" Value="1.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,3">
                                            <Border DockPanel.Dock="Left"
                                                    Background="{Binding BadgeColor, Converter={StaticResource StringToBrushConverter}}"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    Margin="0,0,6,0">
                                                <TextBlock Text="{Binding BadgeText}"
                                                           Foreground="White"
                                                           FontSize="10"
                                                           FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding CreatedAtText}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,2"/>
                                        <TextBlock Text="{Binding InfoText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Ô dưới: BIỂU ĐỒ THỜI GIAN TỰ HỌC QUA TỪNG NGÀY CỦA MÔN HỌC -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="📊 Biểu Đồ Tự Học Theo Ngày"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DockPanel>

                        <!-- Biểu đồ cột 7 ngày gần nhất -->
                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8,10,8,8"
                                Margin="0,0,0,8">
                            <ItemsControl ItemsSource="{Binding SubjectDailyStudyChart}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Bottom"
                                                    ToolTip="{Binding TooltipText}"
                                                    Margin="1,0">
                                            <TextBlock Text="{Binding TimeValueText}"
                                                       FontSize="9.5"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,4"/>
                                            <Grid Height="84" VerticalAlignment="Bottom">
                                                <Border Width="18"
                                                        Height="84"
                                                        CornerRadius="5"
                                                        Background="{DynamicResource CardBorderBrush}"
                                                        Opacity="0.28"
                                                        VerticalAlignment="Bottom"/>
                                                <Border Width="18"
                                                        Height="{Binding BarHeight}"
                                                        CornerRadius="5"
                                                        Background="{Binding BarColorHex, Converter={StaticResource StringToBrushConverter}}"
                                                        VerticalAlignment="Bottom"/>
                                            </Grid>
                                            <TextBlock Text="{Binding DayLabel}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding DateSubLabel}"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Danh sách ngắn ngày giờ bắt đầu - kết thúc bên dưới biểu đồ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SubjectStudySessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="8,5"
                                                Margin="0,0,0,5">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding DurationFormatted}"
                                                           FontSize="10.5"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentTealBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ShortTimeRangeText}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE"/>

            <!-- ========================================================================= -->
            <!-- VÙNG CHÍNH: KHÔNG GIAN HỌC TẬP SPLIT-PANE HIỆN ĐẠI                         -->
            <!-- (Cột 0: Trình đọc tài liệu siêu nét • Cột 2: Study Margin & Flashcard)    -->
            <!-- ========================================================================= -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.75*" MinWidth="480"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1.0*" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <!-- PHẦN 1: TRÌNH ĐỌC TÀI LIỆU SIÊU NÉT (HIGH-RES DOCUMENT READER) -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16">
                    <DockPanel>
                        <!-- Thanh điều khiển Đọc tài liệu: Trang, Zoom, Fit Width, Mở ngoài, Xóa -->
                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,8"
                                Margin="0,0,0,12">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="◀"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinHeight="30" Width="32" Padding="0"
                                            Command="{Binding PreviousCanvasPageCommand}"
                                            ToolTip="Trang trước"
                                            Margin="0,0,4,0"/>
                                    <Border Background="{DynamicResource CardBgBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,4"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PageIndicatorText}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                    <Button Content="▶"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinHeight="30" Width="32" Padding="0"
                                            Command="{Binding NextCanvasPageCommand}"
                                            ToolTip="Trang sau"
                                            Margin="0,0,8,0"/>

                                    <Button Content="➖"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinHeight="30" Width="30" Padding="0"
                                            Command="{Binding ZoomOutCanvasCommand}"
                                            ToolTip="Thu nhỏ"
                                            Margin="0,0,3,0"/>
                                    <Button Content="{Binding CanvasZoomPercentText}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinHeight="30" Padding="8,4" FontSize="11"
                                            Command="{Binding ResetCanvasZoomCommand}"
                                            ToolTip="Đặt lại 100%"
                                            Margin="0,0,3,0"/>
                                    <Button Content="➕"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinHeight="30" Width="30" Padding="0"
                                            Command="{Binding ZoomInCanvasCommand}"
                                            ToolTip="Phóng to"
                                            Margin="0,0,6,0"/>

                                    <Button Content="↔ Fit"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinHeight="30" Padding="8,4" FontSize="11"
                                            Command="{Binding FitWidthCanvasCommand}"
                                            ToolTip="Vừa chiều ngang (125%)"
                                            Margin="0,0,6,0"/>

                                    <Button Content="↗"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinHeight="30" Width="30" Padding="0"
                                            ToolTip="Mở bằng ứng dụng mặc định trên máy"
                                            Command="{Binding OpenDocumentExternalCommand}"
                                 AutomationProperties.Name="Mở file gốc bằng ứng dụng ngoài"
                                 AutomationProperties.AutomationId="OpenExternalButton"
                                            Margin="0,0,6,0"/>

                                    <Button Content="🗑️"
                                            Style="{StaticResource DangerButtonStyle}"
                                            MinHeight="30" Width="30" Padding="0"
                                            ToolTip="Xóa tài liệu này"
                                            Command="{Binding DeleteSelectedDocumentCommand}"
                                            AutomationProperties.Name="Xóa tài liệu đang chọn"
                                            AutomationProperties.AutomationId="DeleteDocumentButton"/>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{Binding SelectedDocument.BadgeColor, Converter={StaticResource StringToBrushConverter}, FallbackValue=#2F6FEB}"
                                            CornerRadius="5"
                                            Padding="7,2"
                                            Margin="0,0,8,0">
                                        <TextBlock Text="{Binding SelectedDocument.BadgeText, FallbackValue='📄 TÀI LIỆU'}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="{Binding SelectedDocument.Title, FallbackValue='Trình đọc Tài liệu Siêu Nét'}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="240"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- KHUNG TRÌNH ĐỌC TÀI LIỆU CHÍNH (BÀN TAY KÉO DI CHUYỂN TÀI LIỆU + CTRL LĂN CHUỘT ZOOM) -->
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                ClipToBounds="True">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="16"
                                          Cursor="Hand"
                                          helpers:CanvasDragHelper.EnableBoardPanAndZoom="True"
                                          AutomationProperties.Name="Vùng xem tài liệu"
                                          AutomationProperties.AutomationId="DocumentViewerArea"
                                          ToolTip="Bàn tay di chuyển: Giữ chuột trái kéo trang • Phóng to/Thu nhỏ: Giữ phím Ctrl + Lăn chuột">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="Hand">
                                    <!-- Khi chưa có tài liệu nào được chọn -->
                                    <Border Width="600"
                                            Padding="40,60"
                                            Background="#FFFFFF"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,30,0,0"
                                            HorizontalAlignment="Center"
                                            Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="📄" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                            <TextBlock Text="Chưa có tài liệu học tập"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       Foreground="#0F172A"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Text="Bấm nút 'Thêm tài liệu' ở cột bên trái hoặc nút bên dưới để nạp file PDF, Word (.docx), hoặc Slide PowerPoint (.pptx)."
                                                       FontSize="13"
                                                       Foreground="#475569"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,20"/>
                                            <Button Content="📂 + Thêm Tài liệu (PDF / Word / PPT)"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding ImportDocumentFileCommand}"
                                                    AutomationProperties.Name="Thêm tài liệu (bảng trống)"
                                                    AutomationProperties.AutomationId="AddDocumentBoardEmptyButton"
                                                    HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Khi đã có tài liệu: Trang tài liệu với độ rộng 920px và Ultra-HD render -->
                                    <Border Width="{Binding CurrentCanvasPage.CanvasWidth, FallbackValue=920}"
                                            Background="#FFFFFF"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="6"
                                            HorizontalAlignment="Center"
                                            Cursor="Hand"
                                            Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding CanvasZoom}"
                                                            ScaleY="{Binding CanvasZoom}"/>
                                        </Border.LayoutTransform>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="5" Opacity="0.38"/>
                                        </Border.Effect>

                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Top"
                                                    Background="{Binding CurrentCanvasPage.AccentColor, Converter={StaticResource StringToBrushConverter}, FallbackValue=#2F6FEB}"
                                                    CornerRadius="4,4,0,0"
                                                    Padding="16,8">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left"
                                                               Text="{Binding CurrentCanvasPage.PageLabel}"
                                                               Foreground="White"
                                                               FontSize="12"
                                                               FontWeight="Bold"/>
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Text="{Binding CurrentCanvasPage.Title}"
                                                               Foreground="#F8FAFC"
                                                               FontSize="12"
                                                               HorizontalAlignment="Right"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </Border>

                                            <StackPanel Margin="18,16" Cursor="Hand">
                                                <Image Source="{Binding CurrentCanvasPage.PageImage}"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       RenderOptions.EdgeMode="Aliased"
                                                       SnapsToDevicePixels="True"
                                                       Cursor="Hand"
                                                       Visibility="{Binding CurrentCanvasPage.HasPageImage, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       Margin="0,0,0,12"/>

                                                <StackPanel Visibility="{Binding CurrentCanvasPage.HasTextContent, Converter={StaticResource BoolToVisibilityConverter}}" Cursor="Hand">
                                                    <TextBlock Text="{Binding CurrentCanvasPage.Title}"
                                                               FontSize="17"
                                                               FontWeight="Bold"
                                                               Foreground="#0F172A"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,10"/>
                                                    <Separator Background="#CBD5E1" Margin="0,0,0,12"/>
                                                    <TextBox Text="{Binding CurrentCanvasPage.Content, Mode=OneWay}"
                                                             IsReadOnly="True"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             FontSize="14"
                                                             Foreground="#1E293B"
                                                             TextWrapping="Wrap"
                                                             AcceptsReturn="True"
                                                             Cursor="Hand"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- GRID SPLITTER GIỮA TRÌNH ĐỌC VÀ STUDY MARGIN -->
                <GridSplitter Grid.Column="1"
                              Width="8"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              Cursor="SizeWE"/>

                <!-- PHẦN 2: STUDY MARGIN / FLASHCARD GẮN VỚI TÀI LIỆU ĐANG MỞ -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                    <DockPanel>
                        <!-- Thanh tiêu đề Study Margin + Nút Thêm Thẻ -->
                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,8"
                                Margin="0,0,0,12">
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="📌 + Thêm Thẻ"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinHeight="30" Padding="12,4" FontSize="11.5"
                                        Command="{Binding TogglePinFormCommand}"/>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="📌 Study Margin &amp; Flashcard"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding PinnedFlashcardsCount, StringFormat='{}Gắn với tài liệu này ({0} thẻ)'}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- KHI TÀI LIỆU NÀY CHƯA CÓ FLASHCARD -->
                        <Border DockPanel.Dock="Top"
                                Style="{StaticResource PlaceholderBorderStyle}"
                                Padding="16,24"
                                Visibility="{Binding HasPinnedFlashcards, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📝" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Chưa có thẻ ghi nhớ"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Mỗi tài liệu có danh sách Flashcard riêng biệt. Đọc tài liệu bên trái và bấm '+ Thêm Thẻ' để đính kèm kiến thức ôn tập!"
                                           Style="{StaticResource MutedTextStyle}"
                                           TextAlignment="Center"
                                           Margin="0,0,0,14"/>
                                <Button Content="📌 + Thêm Thẻ Mới"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding TogglePinFormCommand}"
                                        HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- DANH SÁCH FLASHCARDS CỦA TÀI LIỆU (ACTIVE RECALL: LẬT MẶT TRƯỚC / SAU & ĐÁNH GIÁ THUỘC BÀI) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasPinnedFlashcards, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding PinnedFlashcards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12"
                                                Background="{Binding NotePaperColorHex, Converter={StaticResource StringToBrushConverter}, FallbackValue=#FEF9C3}"
                                                BorderBrush="#94A3B8"
                                                BorderThickness="1.2"
                                                CornerRadius="10"
                                                Padding="14,12">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.25"/>
                                            </Border.Effect>

                                            <StackPanel>
                                                <!-- Thanh header: Trạng thái thuộc bài + Nút xóa thẻ -->
                                                <DockPanel Margin="0,0,0,8">
                                                    <Button DockPanel.Dock="Right"
                                                            Content="✕"
                                                            ToolTip="Xóa thẻ ghi nhớ này"
                                                            Command="{Binding DataContext.UnpinFlashcardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#EF4444"
                                                            Foreground="White"
                                                            FontWeight="Bold"
                                                            FontSize="10"
                                                            Width="22"
                                                            Height="22"
                                                            BorderThickness="0"
                                                            Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="11">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    <Button DockPanel.Dock="Left"
                                                            Content="{Binding PinBadgeText}"
                                                            ToolTip="Bấm để đổi trạng thái: Note ghim → Đang ôn → Đã thuộc"
                                                            Command="{Binding DataContext.CyclePinnedCardMasteryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="{Binding PinThumbColor, Converter={StaticResource StringToBrushConverter}}"
                                                            Foreground="White"
                                                            FontSize="10.5"
                                                            FontWeight="Bold"
                                                            Padding="8,2"
                                                            BorderThickness="0"
                                                            Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DockPanel>

                                                <!-- Mặt trước: Câu hỏi / Khái niệm -->
                                                <TextBlock Text="{Binding Question}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="#0F172A"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,8"/>

                                                <!-- Mặt sau: Đáp án chi tiết (Có thể ẩn/hiện để tự kiểm tra kiến thức) -->
                                                <Border Background="#FFFFFF"
                                                        Opacity="0.92"
                                                        CornerRadius="6"
                                                        Padding="10,8"
                                                        Margin="0,0,0,8"
                                                        Visibility="{Binding IsAnswerVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding Answer}"
                                                               FontSize="12.5"
                                                               Foreground="#1E293B"
                                                               TextWrapping="Wrap"/>
                                                </Border>

                                                <!-- Nút Lật Thẻ (Active Recall) -->
                                                <Button Content="{Binding FlipButtonText}"
                                                        Command="{Binding DataContext.FlipPinnedCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#0F172A"
                                                        Foreground="#F8FAFC"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Padding="10,4"
                                                        BorderThickness="0"
                                                        HorizontalAlignment="Left"
                                                        Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================================================= -->
        <!-- TAB 2: TRỢ LÝ AI - tách riêng thành AiAssistantTabView                    -->
        <!-- ========================================================================= -->
        <local:AiAssistantTabView Grid.Row="2"
                                  Visibility="{Binding SelectedTab, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=AI}"/>

        <!-- ========================================================================= -->
        <!-- CỬA SỐ POPUP NỔI: TẠO & GHIM FLASHCARD / NOTE LÊN BẢNG BLUEPRINT           -->
        <!-- (Nhảy lên khi người dùng bấm nút '📌 + Ghim Flashcard / Note')            -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              Panel.ZIndex="999"
              Background="#88020617"
              Visibility="{Binding IsPinPopupOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Style="{StaticResource CardBorderStyle}"
                    Width="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource PrimaryBrush}"
                    BorderThickness="2"
                    Padding="24,20">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8" Opacity="0.6"/>
                </Border.Effect>

                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right"
                                Content="✕"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="30" Width="32" Padding="0"
                                Command="{Binding ClosePinPopupCommand}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📌 Tạo Flashcard Gắn Liền Với Tài Liệu Này"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Điền câu hỏi và đáp án bên dưới. Flashcard sẽ được lưu trong Study Margin gắn liền với tài liệu đang mở để bạn ôn tập bất cứ lúc nào."
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,0,0,14"/>

                    <!-- Chọn màu giấy Note ghim -->
                    <TextBlock Text="🎨 Chọn màu giấy Note ghim:"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="Vàng Post-it"
                                Command="{Binding SelectNoteColorCommand}"
                                CommandParameter="#FEF9C3"
                                Background="#FEF9C3"
                                Foreground="#0F172A"
                                FontWeight="Bold"
                                FontSize="11.5"
                                Padding="10,5"
                                Margin="0,0,8,0"
                                Cursor="Hand"/>
                        <Button Content="Xanh Mint"
                                Command="{Binding SelectNoteColorCommand}"
                                CommandParameter="#DCFCE7"
                                Background="#DCFCE7"
                                Foreground="#0F172A"
                                FontWeight="Bold"
                                FontSize="11.5"
                                Padding="10,5"
                                Margin="0,0,8,0"
                                Cursor="Hand"/>
                        <Button Content="Xanh Lam"
                                Command="{Binding SelectNoteColorCommand}"
                                CommandParameter="#DBEAFE"
                                Background="#DBEAFE"
                                Foreground="#0F172A"
                                FontWeight="Bold"
                                FontSize="11.5"
                                Padding="10,5"
                                Margin="0,0,8,0"
                                Cursor="Hand"/>
                        <Button Content="Hồng Phấn"
                                Command="{Binding SelectNoteColorCommand}"
                                CommandParameter="#FCE7F3"
                                Background="#FCE7F3"
                                Foreground="#0F172A"
                                FontWeight="Bold"
                                FontSize="11.5"
                                Padding="10,5"
                                Cursor="Hand"/>
                    </StackPanel>

                    <!-- Ô nhập Mặt trước -->
                    <TextBlock Text="1. Mặt trước (Câu hỏi / Tiêu đề Note lưu ý):"
                               FontSize="12.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding NewPinQuestion, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,14"/>

                    <!-- Ô nhập Mặt sau -->
                    <TextBlock Text="2. Mặt sau (Đáp án / Nội dung ghi chú chi tiết):"
                               FontSize="12.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding NewPinAnswer, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="95"
                             VerticalContentAlignment="Top"
                             Margin="0,0,0,18"/>

                    <!-- Nút hành động -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClosePinPopupCommand}"
                                Margin="0,0,10,0"/>
                        <Button Content="📌 Lưu Flashcard Cho Tài Liệu"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding PinFlashcardToCanvasCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
