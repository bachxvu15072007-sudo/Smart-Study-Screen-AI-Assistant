<UserControl x:Class="ScreenAIAssistant.Views.SubjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1080"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="32,26"
                  Background="{DynamicResource AppBackgroundBrush}">
        <StackPanel>

            <!-- 1. THANH TIÊU ĐỀ & NÚT THÊM MÔN HỌC -->
            <DockPanel Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="📚 Danh Sách Môn Học"
                               Style="{StaticResource PageTitleTextStyle}"/>
                    <TextBlock Text="Bấm vào một môn học bất kỳ để mở Không gian Học tập riêng (Tài liệu, AI, Flashcard, Ghi chú) của môn đó"
                               Style="{StaticResource PageSubtitleTextStyle}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <!-- Ô tìm kiếm môn học -->
                    <Grid Width="240" Margin="0,0,12,0">
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="🔍 Tìm kiếm môn học..."
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchKeyword}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Content="➕ Thêm Môn Học"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ShowAddFormCommand}"/>
                </StackPanel>
            </DockPanel>

            <!-- 2. THÔNG BÁO LỖI / TRẠNG THÁI (NẾU CÓ) -->
            <Border Background="{DynamicResource DangerLightBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,14"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontWeight="SemiBold"/>
            </Border>

            <!-- 3. KHUNG THÊM / SỬA MÔN HỌC (CHỈ HIỆN KHI BẤM "+ THÊM MÔN HỌC" HOẶC "SỬA") -->
            <Border Style="{StaticResource CardBorderStyle}"
                    Margin="0,0,0,20"
                    BorderBrush="{DynamicResource PrimaryBrush}"
                    BorderThickness="1.5"
                    Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitleTextStyle}">
                                    <Setter Property="Text" Value="➕ Thêm Môn Học Mới"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Text" Value="✏️ Chỉnh Sửa Môn Học"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button DockPanel.Dock="Right"
                                Content="✖ Đóng"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="32"
                                Command="{Binding CancelFormCommand}"
                                HorizontalAlignment="Right"/>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tên môn học -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tên môn học (*):"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Mô tả -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Mô tả ngắn / Giảng viên / Học kỳ:"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding DescriptionInput, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Chọn màu đại diện -->
                        <StackPanel Grid.Column="4">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Màu nhãn:"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,8,0"/>
                                <Border Width="18" Height="18"
                                        CornerRadius="5"
                                        Background="{Binding ColorInput, Converter={StaticResource StringToBrushConverter}}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding ColorPalette}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="28" Height="28"
                                                Margin="0,0,6,0"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="14"
                                                            Background="{Binding Converter={StaticResource StringToBrushConverter}}"
                                                            BorderBrush="#33000000"
                                                            BorderThickness="1.5"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Hủy"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelFormCommand}"
                                Margin="0,0,10,0"/>
                        <Button Content="💾 Lưu Môn Học"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveSubjectCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 4. DANH SÁCH CÁC THẺ MÔN HỌC (TOÀN MÀN HÌNH, ĐÃ BỎ CỘT PHẢI) -->
            <ItemsControl ItemsSource="{Binding SubjectList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}"
                                Margin="0,0,0,14"
                                Padding="22,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Dải màu nhận diện môn học -->
                                <Border Grid.Column="0"
                                        Background="{Binding Subject.ColorHex, Converter={StaticResource StringToBrushConverter}}"
                                        CornerRadius="3"
                                        Margin="0,0,16,0"/>

                                <!-- Vùng bấm vào tên/mô tả môn học để mở Không gian Học tập -->
                                <Button Grid.Column="1"
                                        Command="{Binding DataContext.OpenSubjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Subject.Name}"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                                        <TextBlock Text="{Binding Subject.Description}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,4,0,12"
                                                   TextWrapping="Wrap"/>

                                        <!-- Huy hiệu số lượng Tài liệu & Flashcard bên trong môn -->
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                                    CornerRadius="6"
                                                    Padding="10,4"
                                                    Margin="0,0,10,0">
                                                <TextBlock Text="{Binding NotesCount, StringFormat='📄 {0} tài liệu &amp; ghi chú'}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource SuccessLightBrush}"
                                                    CornerRadius="6"
                                                    Padding="10,4">
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SuccessBrush}">
                                                    <Run Text="🎴 "/>
                                                    <Run Text="{Binding MasteredCount, Mode=OneWay}"/>
                                                    <Run Text="/"/>
                                                    <Run Text="{Binding FlashcardsCount, Mode=OneWay}"/>
                                                    <Run Text=" thẻ nhớ đã thuộc"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <!-- Cột nút thao tác bên phải mỗi thẻ môn học -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="16,0,0,0">
                                    <Button Content="📖 Vào Không gian Học tập"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding DataContext.OpenSubjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,8,0"/>

                                    <Button Content="✏️"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Width="38" Padding="0"
                                            ToolTip="Sửa thông tin môn học"
                                            Command="{Binding DataContext.ShowEditFormCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,6,0"/>

                                    <Button Content="🗑️"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Width="38" Padding="0"
                                            ToolTip="Xóa môn học"
                                            Command="{Binding DataContext.DeleteSubjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
